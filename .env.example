# Connection string do banco. Para MySQL local:
# DATABASE_URL=mysql+pymysql://root:senha@localhost:3306/cmda_personal
# Para rodar sem MySQL instalado (dev rápido), pode usar SQLite:
# DATABASE_URL=sqlite:///./cmda_personal.db
DATABASE_URL=mysql+pymysql://root:senha@localhost:3306/cmda_personal

# Gere um valor forte para produção, ex: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Expiração do código OTP e do token de reset de senha
OTP_EXPIRE_MINUTES=5
RESET_TOKEN_EXPIRE_MINUTES=15

# CORS: origens permitidas (separadas por vírgula). Use * apenas em dev.
CORS_ORIGINS=*
